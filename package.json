{
  "name": "comicdb",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "npm run migrate && next dev",
    "build": "next build --webpack",
    "start": "npm run migrate && next start",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "test:watch": "vitest",
    "lint": "eslint . --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "google:provision": "bash scripts/provision-google-cloud.sh",
    "google:configure": "bash scripts/configure-google.sh",
    "migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.4.1",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "0.45.2",
    "googleapis": "^173.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.0",
    "unzipper": "^0.12.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/unzipper": "^0.10.11",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "gaxios": "^7.3.0",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
